{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pico logic analyzer Cycle 1 checkpoint evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint",
    "result",
    "timestamp_utc",
    "tested_commit",
    "tested_tree",
    "worktree_state",
    "environment",
    "lock_sha256",
    "commands",
    "verifier",
    "sources",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "checkpoint": {"type": "string", "pattern": "^C1-B[1-5]$"},
    "result": {"enum": ["pass", "fail"]},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "tested_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tested_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "worktree_state": {"type": "string", "maxLength": 2048},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "python"],
      "properties": {
        "os": {"type": "string", "maxLength": 128},
        "architecture": {"type": "string", "maxLength": 64},
        "python": {"type": "string", "maxLength": 64}
      }
    },
    "lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_status"],
        "properties": {
          "command": {"type": "string", "maxLength": 512},
          "exit_status": {"type": "integer", "minimum": 0, "maximum": 255}
        }
      }
    },
    "verifier": {"type": "string", "minLength": 1, "maxLength": 128},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "revision"],
        "properties": {
          "category": {
            "enum": ["observed-wire", "firmware-source", "csharp-source", "synthetic", "hardware-observation"]
          },
          "revision": {"type": "string", "minLength": 1, "maxLength": 128},
          "artifact": {"type": "string", "maxLength": 256},
          "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "maxLength": 256},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "board", "firmware", "front_end", "parameters"],
      "properties": {
        "port": {"const": "<PORT_SUPPLIED>"},
        "board": {"type": "string", "maxLength": 128},
        "firmware": {"type": "string", "maxLength": 128},
        "front_end": {"type": "string", "maxLength": 256},
        "parameters": {"type": "object"}
      }
    }
  }
}
